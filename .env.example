# Bedrock. Never commit real values — this file is the only one that ships.
AWS_PROFILE=shopgeist-admin
AWS_REGION=us-east-1

# Bedrock surface. This account is NOT enabled for Mantle, so the classic
# InvokeModel path is the default. Switch once Mantle access is granted.
# BEDROCK_BACKEND=mantle

